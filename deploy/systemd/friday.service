[Unit]
Description=Friday Assistant Voice Daemon
Documentation=https://github.com/bittu1400/friday
# The daemon needs the Wayland/audio session env (WAYLAND_DISPLAY, DBUS, the
# Hyprland signature) to reach the compositor, launch apps, and use the mic/
# speaker. Under uwsm that env is finalized into the user manager only when the
# graphical session comes up, so bind to graphical-session.target — NOT
# default.target, which can start us before the compositor has published it and
# leave the daemon blind. PartOf ties our lifecycle to the session (stops on
# logout, restarts with it).
After=graphical-session.target friday-llm.service friday-searxng.service
Wants=friday-llm.service friday-searxng.service
PartOf=graphical-session.target
# Keep retrying across a slow dependency start; don't let the default rate
# limiter stop the daemon permanently.
StartLimitIntervalSec=0

[Service]
Type=notify
WatchdogSec=10s
WorkingDirectory=%h/Projects/Personal/Intern/friday
ExecStart=%h/Projects/Personal/Intern/friday/.venv/bin/python -m friday.voice_main
Restart=always
RestartSec=3s
# %t/friday (XDG_RUNTIME_DIR/friday) holds the PTT socket (config.RUNTIME_DIR).
# /run is tmpfs and wiped on reboot, so systemd must recreate the dir on every
# start — without this, ReadWritePaths=%t/friday below fails NAMESPACE setup
# ("No such file or directory") before Python ever runs. 0700: local IPC only.
RuntimeDirectory=friday
RuntimeDirectoryMode=0700
PassEnvironment=WAYLAND_DISPLAY XDG_RUNTIME_DIR HYPRLAND_INSTANCE_SIGNATURE DBUS_SESSION_BUS_ADDRESS PATH
ReadWritePaths=%h/.local/state/friday %t/friday %h/.local/share/friday

# Sandboxing and security
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict

[Install]
WantedBy=graphical-session.target
